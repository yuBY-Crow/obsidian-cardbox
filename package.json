{
	"name": "cardbox",
	"version": "0.6.27",
	"description": "CardBox Obsidian plugin: Writeathon-style slip box for mobile-first flash capture.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node scripts/linktest.mjs && node scripts/boxtest.mjs && node scripts/canvastest.mjs && node scripts/graphtest.mjs && node scripts/renametest.mjs && node scripts/diagnose.mjs",
		"preview": "node scripts/preview.mjs",
		"zip:mobile": "node scripts/zip-mobile.mjs",
		"test:load": "node scripts/loadtest.mjs",
		"test:dom": "node scripts/domtest.mjs",
		"test:links": "node scripts/linkintegrationtest.mjs",
		"seed:links": "node scripts/seed-links.mjs",
		"test:count": "node scripts/counttest.mjs",
		"test:title": "node scripts/titlelinktest.mjs",
		"test:depth": "node scripts/canvasdepthtest.mjs",
		"preview:canvas": "node scripts/canvaspreview.mjs",
		"test:touch": "node scripts/touchtest.mjs",
		"test:masonry": "node scripts/masonrytest.mjs",
		"test:expand": "node scripts/expandtest.mjs"
	},
	"keywords": [],
	"author": "CardBox",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.15.17",
		"builtin-modules": "3.3.0",
		"esbuild": "0.25.5",
		"obsidian": "latest",
		"typescript": "^5.8.3"
	}
}
