{
	"name": "cardbox",
	"version": "0.3.0",
	"description": "CardBox Obsidian plugin: Writeathon-style slip box for mobile-first flash capture.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
